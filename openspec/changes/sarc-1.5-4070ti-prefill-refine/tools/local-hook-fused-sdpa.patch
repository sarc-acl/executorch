+GlobalWorkGrid fused_sdpa_skip(
+    ComputeGraph* graph,
+    const GlobalWorkGrid& gwg,
+    const std::vector<ValueRef>& resize_args) {
+  if (!fused_sdpa_active(graph, resize_args)) {
+    return gwg;
+  }
+  return GlobalWorkGrid(
+      {0u, 0u, 0u},
+      kTiledWorkGrid,
+      gwg.required_lwg_size().is_valid()
+          ? gwg.required_lwg_size()
+          : LocalWorkGroup(8u, 8u, 1u));
+}
