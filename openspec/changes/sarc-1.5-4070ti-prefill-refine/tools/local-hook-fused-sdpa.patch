+int64_t fused_sdpa_tile() {
+  static const int64_t tile = [] {
+    const char* v = std::getenv("ET_VK_SARC_FUSED_SDPA");
+    return v == nullptr ? int64_t(0) : int64_t(std::atoi(v));
+  }();
+  return tile;
+}
+
+// Whether the fused kernel computes the output for the current shape (the
+// kernel checks the same condition and does nothing otherwise).
+bool fused_sdpa_active(
+    ComputeGraph* graph,
+    const std::vector<ValueRef>& resize_args) {
+  const int64_t tile = fused_sdpa_tile();
+  if (tile <= 0 || mode_of(resize_args) != SDPAMode::LLM) {
+    return false;
+  }
+  const ValueRef q = resize_args.at(0);
+  if (graph->storage_type_of(q) != utils::kBuffer ||
+      graph->dtype_of(q) != vkapi::kHalf) {
+    return false;
+  }
+  const int64_t D = graph->size_at<int64_t>(-1, q);
+  const int64_t S = graph->size_at<int64_t>(-3, q);
+  const ValueRef pos = resize_args.at(2);
+  const int64_t input_pos = is_valid(pos) ? graph->read_symint(pos) : 0;
+  return (D == 64 || D == 128) && S > 1 && S % 16 == 0 &&
+      (S + input_pos) % tile == 0;
+}
+
+// The three-node path is reduced to one (junk) workgroup per node when the
