@@ -202,6 +202,13 @@
   if (!device_has_active_rows(device_info(&graph), Op::kSdpaQk)) {
     return upstream_name;
   }
+  static const std::string kStem = "sdpa_attn_weights_softmax";
+  const Override& o = get_override();
+  if (o.sdpa_softmax_family != nullptr && upstream_name.rfind(kStem, 0) == 0) {
+    if (const char* family = o.sdpa_softmax_family()) {
