+// SWEEP-EXP: projection shapes beyond the Llama table, not for commit.
+// {K, N} of Qwen2.5 0.5B / 1.5B, Gemma 2 2B, Qwen3 4B / 8B, Phi-3 mini and
+// the Llama controls.
+const std::vector<std::pair<int64_t, int64_t>>& sweep_kn() {
+  static const std::vector<std::pair<int64_t, int64_t>> kn = {
+      {896, 896},     {896, 128},     {896, 4864},   {4864, 896},
+      {1536, 1536},   {1536, 256},    {1536, 8960},  {8960, 1536},
+      {2304, 2048},   {2304, 1024},   {2048, 2304},  {2304, 9216},
+      {9216, 2304},   {2560, 4096},   {2560, 1024},  {4096, 2560},
+      {2560, 9728},   {9728, 2560},   {3072, 9216},  {3072, 16384},
+      {4096, 12288},  {12288, 4096},  {2048, 2048},  {2048, 8192},
+      {3072, 8192},   {8192, 3072},   {4096, 4096},  {4096, 14336},
+      {14336, 4096},  {4096, 1024},
+  };
+  return kn;
+}
+
+REGISTER_TEST_CASE_SET("q4gsw_linear", "wmma_sweep_correctness") {
+  std::vector<TestCase> cases;
+  for (const std::string op : {"linear_q4gsw", "linear_dq8ca_q4gsw"}) {
+    for (const int64_t M : {256, 300}) {
+      for (const auto& kn : sweep_kn()) {
+        const CoopmatLinearConfig cfg{M, kn.first, kn.second, 128, op};
+        TestCase t = make_case(cfg, utils::kTexture3D);
+        set_family_data(t, cfg);
+        cases.push_back(std::move(t));
+      }
+    }
+  }
+  return {
+      std::move(cases),
+      family_reference,
+      flop_calc,
+      /*warmup_runs=*/1,
+      /*benchmark_runs=*/1};
+}
+
+REGISTER_TEST_CASE_SET("q4gsw_linear", "wmma_sweep_perf") {
+  std::vector<TestCase> cases;
+  for (const std::string op : {"linear_q4gsw", "linear_dq8ca_q4gsw"}) {
+    for (const int64_t M : {512, 2048}) {
+      for (const auto& kn : sweep_kn()) {
+        const CoopmatLinearConfig cfg{M, kn.first, kn.second, 128, op};
+        TestCase t = make_case(cfg, utils::kTexture3D);
+        set_family_data(t, cfg);
+        cases.push_back(std::move(t));
+      }
+    }
+  }
+  return {
+      std::move(cases),
+      nullptr,
+      flop_calc,
+      /*warmup_runs=*/3,
+      /*benchmark_runs=*/10};
+}
+
+
+// SWEEP-EXP: group sizes other than 128 and M above 2048.
+std::vector<CoopmatLinearConfig> sweep_gs_shapes() {
+  std::vector<CoopmatLinearConfig> v;
+  const std::vector<std::pair<int64_t, int64_t>> kn = {
+      {2048, 2048}, {896, 4864}, {2304, 9216}, {4096, 14336}, {14336, 4096}};
+  for (const std::string op : {"linear_q4gsw", "linear_dq8ca_q4gsw"}) {
+    for (const int64_t gs : {32, 64, 256}) {
+      for (const auto& p : kn) {
+        v.push_back({512, p.first, p.second, gs, op});
+      }
+    }
+    for (const int64_t M : {3072, 4096}) {
+      for (const auto& p : kn) {
+        if (p.first <= 4096) {
+          v.push_back({M, p.first, p.second, 128, op});
+        }
+      }
+    }
+  }
+  return v;
+}
+
+REGISTER_TEST_CASE_SET("q4gsw_linear", "wmma_sweep_gs_correctness") {
+  std::vector<TestCase> cases;
+  for (const auto& cfg : sweep_gs_shapes()) {
+    TestCase t = make_case(cfg, utils::kTexture3D);
+    t.set_name(
+        cfg.op_name + "_M" + std::to_string(cfg.M) + "_K" +
+        std::to_string(cfg.K) + "_N" + std::to_string(cfg.N) + "_g" +
+        std::to_string(cfg.group_size) + "_Texture3D");
+    set_family_data(t, cfg);
+    cases.push_back(std::move(t));
+  }
+  return {std::move(cases), family_reference, flop_calc, 1, 1};
+}
+
+REGISTER_TEST_CASE_SET("q4gsw_linear", "wmma_sweep_gs_perf") {
+  std::vector<TestCase> cases;
+  for (const auto& cfg : sweep_gs_shapes()) {
+    TestCase t = make_case(cfg, utils::kTexture3D);
+    t.set_name(
+        cfg.op_name + "_M" + std::to_string(cfg.M) + "_K" +
+        std::to_string(cfg.K) + "_N" + std::to_string(cfg.N) + "_g" +
+        std::to_string(cfg.group_size) + "_Texture3D");
+    set_family_data(t, cfg);
+    cases.push_back(std::move(t));
+  }
+  return {std::move(cases), nullptr, flop_calc, 3, 10};
+}
