# specs/023-8da4w-int8-dbuf-sweep: dbuf4 ("store-first") variant of the int8
# dq8ca_q4gsw coopmat linear shader, selected via
# ET_VK_DQ8CA_COOPMAT_VARIANT=dbuf4. Byte-identical loop structure to the
# shipped linear_dq8ca_qw_coopmat.yaml -- see linear_dq8ca_q4gsw_coopmat_dbuf4.glsl.

linear_dq8ca_q4gsw_coopmat_dbuf4:
  parameter_names_with_default_values:
    PRECISION: highp
    HAS_BIAS: false
    WEIGHT_NBITS: 4
    WEIGHT_STORAGE: texture2d
    MMA_M: 16
    MMA_N: 16
    MMA_K: 16
    WG_TILE_M: 128
    WG_TILE_N: 64
    WG_TILE_K: 32
    SG_GRID_X: 2
    SG_GRID_Y: 2
    SUBGROUP_SIZE: 64
  shader_variants:
    - NAME: linear_dq8ca_q4gsw_coopmat_dbuf4_buffer_texture2d_half
      WEIGHT_NBITS: 4
      WEIGHT_STORAGE: texture2d
    - NAME: linear_dq8ca_q4gsw_coopmat_dbuf4_buffer_buffer_half
      WEIGHT_NBITS: 4
      WEIGHT_STORAGE: buffer
