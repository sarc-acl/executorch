/*
 * Body of conv2d_pw_coopmat. The including header defines the bindings, the
 * epilogue, ACC_T, the optional FRAG_LAYOUT macro and the tile constants
 * MMA_{M,N,K}, WG_TILE_{M,N,K}, SG_GRID_{X,Y} and SUBGROUP_SIZE.
 *
 * Each work group computes a WG_TILE_M (pixels) x WG_TILE_N (channels) output
 * tile. gl_WorkGroupID.x is the channel tile; the pixel tile is
 * gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y, so planes with more
 * pixel tiles than the device's maximum work group count in y still fit. Per K
 * step
 * the A tile (input texels) and the B tile (packed 4OC x 4IC weights) are
 * staged into shared memory as fp16, zero-filled past M, N and K, with the next
 * step prefetched into registers during the MMAs (the staging scheme of the
 * linear coopmat kernels). After the K loop the accumulators are stored to
 * shared memory in their own type (fp32 for ACC_FP32), in DRAIN_PASSES passes
 * of DRAIN_G accumulator row blocks per subgroup so the staged part of the
 * result tile fits DRAIN_BUDGET_BYTES, and the work group reads them back to add
 * the bias, apply the epilogue (both in VEC4_T, f32 for ACC_FP32) and imageStore
 * the texels inside the output. The wrapper defines DRAIN_G and DRAIN_PASSES.
 */

#ifndef CONV2D_PW_COOPMAT_BODY_GLSLH
#define CONV2D_PW_COOPMAT_BODY_GLSLH

const uint NUM_SUBGROUPS = SG_GRID_X * SG_GRID_Y;
const uint WG_SIZE = NUM_SUBGROUPS * SUBGROUP_SIZE;

const uint SG_TILE_M = WG_TILE_M / SG_GRID_Y;
const uint SG_TILE_N = WG_TILE_N / SG_GRID_X;
const uint MMAS_PER_SG_M = SG_TILE_M / MMA_M;
const uint MMAS_PER_SG_N = SG_TILE_N / MMA_N;

// Shared memory is addressed in uvec4 units of 8 fp16.
const uint FP16_PER_VEC4 = 8;

#if defined(FRAG_LAYOUT) && defined(BCM)
#error "BCM requires the padded row-major layout"
#endif

#ifdef FRAG_LAYOUT
// Fragment-contiguous layout (Intel Xe2): A as [k16 block][m][16 fp16] and B
// as [n16 block][k][16 fp16], so every A and B fragment is one contiguous run.
// Requires MMA_K == MMA_N == 16.
const uint FRAG_ROW_VEC4 = 16u / FP16_PER_VEC4;
const uint A_STRIDE_VEC4 = FRAG_ROW_VEC4;
const uint B_STRIDE_VEC4 = FRAG_ROW_VEC4;
const uint ASH_SLICE = WG_TILE_M * (WG_TILE_K / FP16_PER_VEC4);
const uint BSH_SLICE = WG_TILE_K * (WG_TILE_N / FP16_PER_VEC4);
#define A_SH_IDX(m, c) \
  ((((c) / FRAG_ROW_VEC4) * WG_TILE_M + (m)) * FRAG_ROW_VEC4 + ((c) % FRAG_ROW_VEC4))
#define B_SH_IDX(k, c) \
  ((((c) / FRAG_ROW_VEC4) * WG_TILE_K + (k)) * FRAG_ROW_VEC4 + ((c) % FRAG_ROW_VEC4))
#elif defined(BCM)
// A row-major and B column-major ([n][k], the K values of an output channel
// contiguous), each row or column padded by one uvec4. B_SH_IDX(n, c): output
// channel n, input channels 8c ...
const uint A_STRIDE_VEC4 = (WG_TILE_K + FP16_PER_VEC4) / FP16_PER_VEC4;
const uint B_STRIDE_VEC4 = (WG_TILE_K + FP16_PER_VEC4) / FP16_PER_VEC4;
const uint ASH_SLICE = WG_TILE_M * A_STRIDE_VEC4;
const uint BSH_SLICE = WG_TILE_N * B_STRIDE_VEC4;
#define A_SH_IDX(m, c) ((m) * A_STRIDE_VEC4 + (c))
#define B_SH_IDX(n, c) ((n) * B_STRIDE_VEC4 + (c))
#else
// Row-major, each row padded by one uvec4.
const uint A_STRIDE_VEC4 = (WG_TILE_K + FP16_PER_VEC4) / FP16_PER_VEC4;
const uint B_STRIDE_VEC4 = (WG_TILE_N + FP16_PER_VEC4) / FP16_PER_VEC4;
const uint ASH_SLICE = WG_TILE_M * A_STRIDE_VEC4;
const uint BSH_SLICE = WG_TILE_K * B_STRIDE_VEC4;
#define A_SH_IDX(m, c) ((m) * A_STRIDE_VEC4 + (c))
#define B_SH_IDX(k, c) ((k) * B_STRIDE_VEC4 + (c))
#endif

// One pool holds the double-buffered A and B tiles and, after the last MMA,
// one drain pass of the result: PASS_ROWS rows of WG_TILE_N accumulators,
// row-major, row (g * SG_GRID_Y + sg.y) * MMA_M + r holding accumulator row
// block (pass * DRAIN_G + g) of the subgroups in grid row sg.y.
#ifdef ACC_FP32
const uint ACC_PER_VEC4 = 4u;
#else
const uint ACC_PER_VEC4 = 8u;
#endif
const uint BAND_ROWS = SG_GRID_Y * MMA_M;
const uint PASS_ROWS = BAND_ROWS * DRAIN_G;
const uint C_ROW_VEC4 = WG_TILE_N / ACC_PER_VEC4;
const uint BSH_BASE = 2u * ASH_SLICE;
const uint POOL_AB = 2u * ASH_SLICE + 2u * BSH_SLICE;
const uint POOL_C = PASS_ROWS * C_ROW_VEC4;
shared uvec4 sh[POOL_AB > POOL_C ? POOL_AB : POOL_C];

// Staging maps. A item = 8 consecutive input channels of one pixel (two
// texels), pixels fastest so neighboring invocations read neighboring texels
// of one channel slice. B item = 8 consecutive output channels of one input
// channel (two packed f16vec4), the 4 input channels of a block fastest so
// neighboring invocations read consecutive weight vectors.
const uint A_COLS = WG_TILE_K / FP16_PER_VEC4;
const uint A_ITEMS = WG_TILE_M * A_COLS;
const uint A_PASSES = (A_ITEMS + WG_SIZE - 1u) / WG_SIZE;
#ifdef BCM
// B item = one packed 4OC x 4IC block: four consecutive f16vec4, transposed
// into four output channels of four input channels each (two uvec4).
const uint B_COLS = WG_TILE_N / 4u;
const uint B_ITEMS = (WG_TILE_K / 4u) * B_COLS;
const uint B_PASSES = (B_ITEMS + WG_SIZE - 1u) / WG_SIZE;
#define B_TEMP_LEN (2u * B_PASSES)
#else
const uint B_COLS = WG_TILE_N / FP16_PER_VEC4;
const uint B_ITEMS = WG_TILE_K * B_COLS;
const uint B_PASSES = (B_ITEMS + WG_SIZE - 1u) / WG_SIZE;
#define B_TEMP_LEN B_PASSES
#endif

coopmat<ACC_T, gl_ScopeSubgroup, MMA_M, MMA_N, gl_MatrixUseAccumulator>
    result[MMAS_PER_SG_M][MMAS_PER_SG_N];

uvec4 pack_f16x8(const f16vec4 lo, const f16vec4 hi) {
  return uvec4(
      packFloat2x16(lo.xy),
      packFloat2x16(lo.zw),
      packFloat2x16(hi.xy),
      packFloat2x16(hi.zw));
}

// Fixed per invocation and pass: the A item's pixel and column, and the B
// item's tile-local input channel and column.
struct StagingMap {
  ivec2 a_pos[A_PASSES];
  bool a_row_ok[A_PASSES];
  uint a_m[A_PASSES];
  uint a_col[A_PASSES];
  uint b_k[B_PASSES];
  uint b_col[B_PASSES];
};

void make_staging_map(
    out StagingMap map,
    const uint tile_m_start,
    const uint M,
    const uint W_out) {
  const uint tid = gl_LocalInvocationID.x;
  [[unroll]] for (uint p = 0; p < A_PASSES; ++p) {
    const uint item = min(p * WG_SIZE + tid, A_ITEMS - 1u);
    map.a_m[p] = item % WG_TILE_M;
    map.a_col[p] = item / WG_TILE_M;
#ifdef ALIGNED
    // Rows past M read the last pixel; the output stage does not store them.
    const uint m = min(tile_m_start + map.a_m[p], M - 1u);
    map.a_row_ok[p] = p * WG_SIZE + tid < A_ITEMS;
    map.a_pos[p] = ivec2(m % W_out, m / W_out);
#else
    const uint m = tile_m_start + map.a_m[p];
    map.a_row_ok[p] = m < M && p * WG_SIZE + tid < A_ITEMS;
    map.a_pos[p] = map.a_row_ok[p] ? ivec2(m % W_out, m / W_out) : ivec2(0);
#endif
  }
  [[unroll]] for (uint p = 0; p < B_PASSES; ++p) {
    const uint item = min(p * WG_SIZE + tid, B_ITEMS - 1u);
#if defined(BCM)
    map.b_col[p] = item % B_COLS;
    map.b_k[p] = (item / B_COLS) * 4u;
#elif defined(W16)
    // B item = 4 output channels (b_col counts 4-channel texels) of two
    // adjacent input channels b_k, b_k + 1 of one packed block: one 16-byte
    // load; the two halves of a block fastest, then the texels of a block row.
    const uint dk2 = item % 2u;
    const uint rest = item / 2u;
    map.b_col[p] = rest % (WG_TILE_N / 4u);
    map.b_k[p] = (rest / (WG_TILE_N / 4u)) * 4u + 2u * dk2;
#else
    const uint dk = item % 4u;
    const uint rest = item / 4u;
    map.b_col[p] = rest % B_COLS;
    map.b_k[p] = (rest / B_COLS) * 4u + dk;
#endif
  }
}

#ifdef IMG_INPUT
#define LOAD_IN(pos) imageLoad(t_in, pos)
#else
#define LOAD_IN(pos) texelFetch(t_in, pos, 0)
#endif

#ifdef ALIGNED
// K % WG_TILE_K == 0 and N % WG_TILE_N == 0 (conv2d_pw_coopmat_ineligible):
// every fetch is inside the tensors.
f16vec4 fetch_in(const ivec2 pos, const uint k4, const uint K4) {
  return f16vec4(LOAD_IN(ivec3(pos, int(k4))));
}

#ifndef W16
f16vec4 fetch_w(const uint k, const uint n4, const uint K4, const uint N4) {
  return f16vec4(t_weight_packed[((k >> 2u) * N4 + n4) * 4u + (k & 3u)]);
}
#endif
#else
#ifdef W16
#error "W16 requires ALIGNED"
#endif
f16vec4 fetch_in(const ivec2 pos, const uint k4, const uint K4) {
  return k4 < K4 ? f16vec4(LOAD_IN(ivec3(pos, int(k4)))) : f16vec4(0);
}

#ifdef SPLIT_K
// The packed weights through the uvec2 view of the buffer, which also holds
// the split-K scratch after the weights.
f16vec4 fetch_w(const uint k, const uint n4, const uint K4, const uint N4) {
  if ((k >> 2u) < K4 && n4 < N4) {
    const uvec2 u = t_weight_u2[((k >> 2u) * N4 + n4) * 4u + (k & 3u)];
    return f16vec4(unpackFloat2x16(u.x), unpackFloat2x16(u.y));
  }
  return f16vec4(0);
}
#else
f16vec4 fetch_w(const uint k, const uint n4, const uint K4, const uint N4) {
  return (k >> 2u) < K4 && n4 < N4
      ? f16vec4(t_weight_packed[((k >> 2u) * N4 + n4) * 4u + (k & 3u)])
      : f16vec4(0);
}
#endif
#endif

void load_a(
    out uvec4 temp[A_PASSES],
    const StagingMap map,
    const uint k_start,
    const uint K4) {
  [[unroll]] for (uint p = 0; p < A_PASSES; ++p) {
    if (map.a_row_ok[p]) {
      const uint k4 = k_start / 4u + 2u * map.a_col[p];
      temp[p] = pack_f16x8(
          fetch_in(map.a_pos[p], k4, K4), fetch_in(map.a_pos[p], k4 + 1u, K4));
    } else {
      temp[p] = uvec4(0);
    }
  }
}

void load_b(
    out uvec4 temp[B_TEMP_LEN],
    const StagingMap map,
    const uint k_start,
    const uint n4_start,
    const uint K4,
    const uint N4) {
  [[unroll]] for (uint p = 0; p < B_PASSES; ++p) {
#if defined(BCM)
    // Entries k .. k + 3 of texel n4 (one packed block); temp[2p] holds
    // channels 4 n4 + 0, 1 and temp[2p + 1] channels 2, 3, each as the four
    // input channels of one output channel.
    const uint k = k_start + map.b_k[p];
    const uint n4 = n4_start + map.b_col[p];
    const f16vec4 r0 = fetch_w(k, n4, K4, N4);
    const f16vec4 r1 = fetch_w(k + 1u, n4, K4, N4);
    const f16vec4 r2 = fetch_w(k + 2u, n4, K4, N4);
    const f16vec4 r3 = fetch_w(k + 3u, n4, K4, N4);
    temp[2u * p] = uvec4(
        packFloat2x16(f16vec2(r0.x, r1.x)),
        packFloat2x16(f16vec2(r2.x, r3.x)),
        packFloat2x16(f16vec2(r0.y, r1.y)),
        packFloat2x16(f16vec2(r2.y, r3.y)));
    temp[2u * p + 1u] = uvec4(
        packFloat2x16(f16vec2(r0.z, r1.z)),
        packFloat2x16(f16vec2(r2.z, r3.z)),
        packFloat2x16(f16vec2(r0.w, r1.w)),
        packFloat2x16(f16vec2(r2.w, r3.w)));
#elif defined(W16)
    // Entries k and k + 1 (k even) of texel n4 are adjacent: f16vec4 element
    // ((k / 4) * N4 + n4) * 4 + k % 4, an even index, is uvec4 element half of it.
    const uint k = k_start + map.b_k[p];
    const uint n4 = n4_start + map.b_col[p];
    temp[p] = t_weight_u4[((k >> 2u) * N4 + n4) * 2u + ((k & 3u) >> 1u)];
#else
    const uint k = k_start + map.b_k[p];
    const uint n4 = n4_start + 2u * map.b_col[p];
    temp[p] = pack_f16x8(fetch_w(k, n4, K4, N4), fetch_w(k, n4 + 1u, K4, N4));
#endif
  }
}

void store_ab(
    const uint slice,
    const uvec4 temp_a[A_PASSES],
    const uvec4 temp_b[B_TEMP_LEN],
    const StagingMap map) {
  const uint tid = gl_LocalInvocationID.x;
  [[unroll]] for (uint p = 0; p < A_PASSES; ++p) {
    if (A_ITEMS % WG_SIZE == 0u || p * WG_SIZE + tid < A_ITEMS) {
      sh[slice * ASH_SLICE + A_SH_IDX(map.a_m[p], map.a_col[p])] = temp_a[p];
    }
  }
  [[unroll]] for (uint p = 0; p < B_PASSES; ++p) {
    if (B_ITEMS % WG_SIZE == 0u || p * WG_SIZE + tid < B_ITEMS) {
#if defined(BCM)
      // Output channels 4 b_col + c, input channels b_k .. b_k + 3: half of a
      // shared vector of channel 4 b_col + c each.
      const uint base = BSH_BASE + slice * BSH_SLICE;
      const uint c8 = map.b_k[p] / FP16_PER_VEC4;
      const uint n = 4u * map.b_col[p];
      if ((map.b_k[p] & 4u) == 0u) {
        sh[base + B_SH_IDX(n, c8)].xy = temp_b[2u * p].xy;
        sh[base + B_SH_IDX(n + 1u, c8)].xy = temp_b[2u * p].zw;
        sh[base + B_SH_IDX(n + 2u, c8)].xy = temp_b[2u * p + 1u].xy;
        sh[base + B_SH_IDX(n + 3u, c8)].xy = temp_b[2u * p + 1u].zw;
      } else {
        sh[base + B_SH_IDX(n, c8)].zw = temp_b[2u * p].xy;
        sh[base + B_SH_IDX(n + 1u, c8)].zw = temp_b[2u * p].zw;
        sh[base + B_SH_IDX(n + 2u, c8)].zw = temp_b[2u * p + 1u].xy;
        sh[base + B_SH_IDX(n + 3u, c8)].zw = temp_b[2u * p + 1u].zw;
      }
#elif defined(W16)
      // Rows b_k and b_k + 1, channels 4 * b_col ..: half of an 8-channel
      // shared vector each.
      const uint base = BSH_BASE + slice * BSH_SLICE;
      const uint i0 = base + B_SH_IDX(map.b_k[p], map.b_col[p] / 2u);
      const uint i1 = base + B_SH_IDX(map.b_k[p] + 1u, map.b_col[p] / 2u);
      if ((map.b_col[p] & 1u) == 0u) {
        sh[i0].xy = temp_b[p].xy;
        sh[i1].xy = temp_b[p].zw;
      } else {
        sh[i0].zw = temp_b[p].xy;
        sh[i1].zw = temp_b[p].zw;
      }
#else
      sh[BSH_BASE + slice * BSH_SLICE + B_SH_IDX(map.b_k[p], map.b_col[p])] =
          temp_b[p];
#endif
    }
  }
}

void mma_step(const uint slice, const uvec2 sg) {
  const uint a_base = slice * ASH_SLICE;
  const uint b_base = BSH_BASE + slice * BSH_SLICE;
  [[unroll]] for (uint k = 0; k < WG_TILE_K / MMA_K; ++k) {
    const uint k_start = MMA_K * k;
    coopmat<float16_t, gl_ScopeSubgroup, MMA_M, MMA_K, gl_MatrixUseA>
        mat_a[MMAS_PER_SG_M];
    [[unroll]] for (uint i = 0; i < MMAS_PER_SG_M; ++i) {
      const uint row = MMA_M * (MMAS_PER_SG_M * sg.y + i);
      coopMatLoad(
          mat_a[i],
          sh,
          a_base + A_SH_IDX(row, k_start / FP16_PER_VEC4),
          A_STRIDE_VEC4,
          gl_CooperativeMatrixLayoutRowMajor);
    }
    coopmat<float16_t, gl_ScopeSubgroup, MMA_K, MMA_N, gl_MatrixUseB> mat_b;
    [[unroll]] for (uint j = 0; j < MMAS_PER_SG_N; ++j) {
#ifdef BCM
      const uint n = MMA_N * (MMAS_PER_SG_N * sg.x + j);
      coopMatLoad(
          mat_b,
          sh,
          b_base + B_SH_IDX(n, k_start / FP16_PER_VEC4),
          B_STRIDE_VEC4,
          gl_CooperativeMatrixLayoutColumnMajor);
#else
      const uint col = MMA_N * (MMAS_PER_SG_N * sg.x + j) / FP16_PER_VEC4;
      coopMatLoad(
          mat_b,
          sh,
          b_base + B_SH_IDX(k_start, col),
          B_STRIDE_VEC4,
          gl_CooperativeMatrixLayoutRowMajor);
#endif
      [[unroll]] for (uint i = 0; i < MMAS_PER_SG_M; ++i) {
        result[i][j] = coopMatMulAdd(mat_a[i], mat_b, result[i][j]);
      }
    }
  }
}

#ifdef DIRECT_B
// Direct weight load (raw-shader probe, design D5): B is not staged. The
// weights are prepacked on the host in MMA_K x MMA_N fragments, row-major,
// fragment (k / MMA_K, n / MMA_N) at index (k / MMA_K) * (N / MMA_N) + n / MMA_N
// (MMA_K * MMA_N / 4 f16vec4 each); every subgroup loads its B fragments with
// subgroup-uniform offsets. Requires K % WG_TILE_K == 0 and N % WG_TILE_N == 0.
void store_a(const uint slice, const uvec4 temp_a[A_PASSES], const StagingMap map) {
  const uint tid = gl_LocalInvocationID.x;
  [[unroll]] for (uint p = 0; p < A_PASSES; ++p) {
    if (A_ITEMS % WG_SIZE == 0u || p * WG_SIZE + tid < A_ITEMS) {
      sh[slice * ASH_SLICE + A_SH_IDX(map.a_m[p], map.a_col[p])] = temp_a[p];
    }
  }
}

void mma_step_direct(
    const uint slice,
    const uvec2 sg,
    const uint k_base,
    const uint n16,
    const uint tile_n_start) {
  const uint a_base = slice * ASH_SLICE;
  [[unroll]] for (uint k = 0; k < WG_TILE_K / MMA_K; ++k) {
    const uint k_start = MMA_K * k;
    coopmat<float16_t, gl_ScopeSubgroup, MMA_M, MMA_K, gl_MatrixUseA>
        mat_a[MMAS_PER_SG_M];
    [[unroll]] for (uint i = 0; i < MMAS_PER_SG_M; ++i) {
      const uint row = MMA_M * (MMAS_PER_SG_M * sg.y + i);
      coopMatLoad(
          mat_a[i],
          sh,
          a_base + A_SH_IDX(row, k_start / FP16_PER_VEC4),
          A_STRIDE_VEC4,
          gl_CooperativeMatrixLayoutRowMajor);
    }
    coopmat<float16_t, gl_ScopeSubgroup, MMA_K, MMA_N, gl_MatrixUseB> mat_b;
    [[unroll]] for (uint j = 0; j < MMAS_PER_SG_N; ++j) {
      const uint n = tile_n_start + MMA_N * (MMAS_PER_SG_N * sg.x + j);
      const uint frag = ((k_base + k_start) / MMA_K) * n16 + n / MMA_N;
      coopMatLoad(
          mat_b,
          t_weight_packed,
          frag * (MMA_K * MMA_N / 4u),
          MMA_N / 4u,
          gl_CooperativeMatrixLayoutRowMajor);
      [[unroll]] for (uint i = 0; i < MMAS_PER_SG_M; ++i) {
        result[i][j] = coopMatMulAdd(mat_a[i], mat_b, result[i][j]);
      }
    }
  }
}
#endif

#ifdef SPLIT_K
// Split-K across work groups (design D6): work group x is the channel tile
// x % n_tiles of K slice x / n_tiles, which runs K steps [slice * q,
// min((slice + 1) * q, steps)) with q = ceil(steps / K_SLICES), and stores its
// accumulator tile, without bias or epilogue, to the scratch after the packed
// weights: texel (slice * M + m) * N4 + n4, one uvec2 per texel for fp16 and
// two for fp32 accumulation. The merge shader sums the slices.
uint g_k_slice;

void store_scratch(const uint m, const uint n4, const uint M, const uint N4, const VEC4_T v) {
  const uint K4 = uint(div_up_4(in_sizes.z));
  const uint base = K4 * N4 * 4u;
  const uint t = (g_k_slice * M + m) * N4 + n4;
#ifdef ACC_FP32
  const uvec4 bits = floatBitsToUint(v);
  t_weight_u2[base + 2u * t] = bits.xy;
  t_weight_u2[base + 2u * t + 1u] = bits.zw;
#else
  t_weight_u2[base + t] = uvec2(packFloat2x16(v.xy), packFloat2x16(v.zw));
#endif
}
#endif

// Stores accumulator row blocks pass * DRAIN_G ... + DRAIN_G - 1 of every
// subgroup, then writes their output texels. `pass` is a literal at every call,
// so the result array is indexed with constants.
void drain_pass(
    const uint pass,
    const uvec2 sg,
    const uint tile_m_start,
    const uint n4_start,
    const uint M,
    const uint N4,
    const uint W_out) {
  // Every subgroup is done with the pool (A/B after the K loop, or the
  // previous pass) before it is overwritten.
  memoryBarrierShared();
  barrier();
  [[unroll]] for (uint g = 0; g < DRAIN_G; ++g) {
    [[unroll]] for (uint j = 0; j < MMAS_PER_SG_N; ++j) {
      const uint c_off = (g * SG_GRID_Y + sg.y) * MMA_M * WG_TILE_N +
          MMA_N * (MMAS_PER_SG_N * sg.x + j);
      coopMatStore(
          result[pass * DRAIN_G + g][j],
          sh,
          c_off / ACC_PER_VEC4,
          C_ROW_VEC4,
          gl_CooperativeMatrixLayoutRowMajor);
    }
  }
  memoryBarrierShared();
  barrier();

  const uint TEXELS_PER_ROW = WG_TILE_N / 4u;
  for (uint t = gl_LocalInvocationID.x; t < PASS_ROWS * TEXELS_PER_ROW;
       t += WG_SIZE) {
    const uint cr = t / TEXELS_PER_ROW;
    const uint lc4 = t % TEXELS_PER_ROW;
    const uint g = cr / BAND_ROWS;
    const uint band_row = cr % BAND_ROWS;
    const uint lr = (band_row / MMA_M) * SG_TILE_M +
        (pass * DRAIN_G + g) * MMA_M + band_row % MMA_M;
    const uint m = tile_m_start + lr;
    const uint n4 = n4_start + lc4;
#ifdef ALIGNED
    if (m < M) {
#else
    if (m < M && n4 < N4) {
#endif
      const uint h = cr * WG_TILE_N + lc4 * 4u;
#ifdef ACC_FP32
      VEC4_T v = uintBitsToFloat(sh[h / ACC_PER_VEC4]);
#else
      const uvec4 q = sh[h / ACC_PER_VEC4];
      const bool hi = (h % ACC_PER_VEC4) != 0u;
      VEC4_T v = VEC4_T(
          unpackFloat2x16(hi ? q.z : q.x), unpackFloat2x16(hi ? q.w : q.y));
#endif
#if defined(SPLIT_K)
      store_scratch(m, n4, M, N4, v);
#elif defined(NO_EPILOGUE)
      // No bias, activation, residual or scale (conv2d_pw_coopmat_ineligible).
      imageStore(t_out, ivec3(m % W_out, m / W_out, n4), vec4(v));
#else
      v += VEC4_T(texelFetch(t_bias, ivec2(n4, 0), 0));
      const vec4 scale =
          has_scale ? texelFetch(t_scale, ivec2(n4, 0), 0) : vec4(1);
      const ivec3 pos = ivec3(m % W_out, m / W_out, n4);
      imageStore(t_out, pos, vec4(apply_epilogue(v, pos, scale)));
#endif
    }
  }
}

void main() {
  const uvec2 sg = uvec2(gl_SubgroupID % SG_GRID_X, gl_SubgroupID / SG_GRID_X);

  const uint W_out = uint(out_sizes.x);
  const uint M = W_out * uint(out_sizes.y);
  const uint N4 = uint(div_up_4(out_sizes.z));
  const uint K4 = uint(div_up_4(in_sizes.z));

  // Uniform per work group, so the early return precedes every barrier of the
  // work group alike.
  const uint tile_m = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
  if (tile_m * WG_TILE_M >= M) {
    return;
  }
  const uint tile_m_start = WG_TILE_M * tile_m;
#ifdef SPLIT_K
  const uint n_tiles = gl_NumWorkGroups.x / K_SLICES;
  g_k_slice = gl_WorkGroupID.x / n_tiles;
  const uint tile_n_start = WG_TILE_N * (gl_WorkGroupID.x % n_tiles);
#else
  const uint tile_n_start = WG_TILE_N * gl_WorkGroupID.x;
#endif
  const uint n4_start = tile_n_start / 4u;
  const uint num_k_steps = (4u * K4 + WG_TILE_K - 1u) / WG_TILE_K;

  [[unroll]] for (uint i = 0; i < MMAS_PER_SG_M; ++i) {
    [[unroll]] for (uint j = 0; j < MMAS_PER_SG_N; ++j) {
      result[i][j] = coopmat<
          ACC_T,
          gl_ScopeSubgroup,
          MMA_M,
          MMA_N,
          gl_MatrixUseAccumulator>(0.0);
    }
  }

  StagingMap map;
  make_staging_map(map, tile_m_start, M, W_out);

#ifdef DIRECT_B
  const uint n16 = 4u * N4 / MMA_N;
  uvec4 temp_a[A_PASSES];
  load_a(temp_a, map, 0u, K4);
  store_a(0u, temp_a, map);
  uint step;
  for (step = 0; step + 1u < num_k_steps; ++step) {
    memoryBarrierShared();
    barrier();
    load_a(temp_a, map, (step + 1u) * WG_TILE_K, K4);
    mma_step_direct(step % 2u, sg, step * WG_TILE_K, n16, tile_n_start);
    store_a((step + 1u) % 2u, temp_a, map);
  }
  memoryBarrierShared();
  barrier();
  mma_step_direct(step % 2u, sg, step * WG_TILE_K, n16, tile_n_start);
#elif defined(SPLIT_K)
  // Every slice holds at least two K steps (conv2d_pw_coopmat_ineligible).
  const uint q = (num_k_steps + K_SLICES - 1u) / K_SLICES;
  const uint s0 = g_k_slice * q;
  const uint s1 = min(s0 + q, num_k_steps);
  uvec4 temp_a[A_PASSES];
  uvec4 temp_b[B_TEMP_LEN];
  load_a(temp_a, map, s0 * WG_TILE_K, K4);
  load_b(temp_b, map, s0 * WG_TILE_K, n4_start, K4, N4);
  store_ab(0u, temp_a, temp_b, map);
  uint step;
  for (step = s0; step + 1u < s1; ++step) {
    memoryBarrierShared();
    barrier();
    const uint k_next = (step + 1u) * WG_TILE_K;
    load_a(temp_a, map, k_next, K4);
    load_b(temp_b, map, k_next, n4_start, K4, N4);
    mma_step((step - s0) % 2u, sg);
    store_ab((step - s0 + 1u) % 2u, temp_a, temp_b, map);
  }
  memoryBarrierShared();
  barrier();
  mma_step((step - s0) % 2u, sg);
#else
  uvec4 temp_a[A_PASSES];
  uvec4 temp_b[B_TEMP_LEN];
  load_a(temp_a, map, 0u, K4);
  load_b(temp_b, map, 0u, n4_start, K4, N4);
  store_ab(0u, temp_a, temp_b, map);

#ifdef DIAG_ONCE
  // Diagnostic: the first K step's tiles are staged into both slices once, and
  // every K step multiplies the slice it would read, so the result is
  // num_k_steps times the first step's product, with the fetch, the staging
  // store and the barrier of the later steps removed.
  store_ab(1u, temp_a, temp_b, map);
  memoryBarrierShared();
  barrier();
  for (uint step = 0; step < num_k_steps; ++step) {
    mma_step(step % 2u, sg);
  }
#else
  // One barrier per K step: the slice being read was written before it, and
  // the slice being written was last read before it.
  uint step;
  for (step = 0; step + 1u < num_k_steps; ++step) {
    // barrier() alone does not order shared stores against a following
    // coopMatLoad on every driver.
    memoryBarrierShared();
    barrier();
    const uint k_next = (step + 1u) * WG_TILE_K;
    load_a(temp_a, map, k_next, K4);
    load_b(temp_b, map, k_next, n4_start, K4, N4);
    mma_step(step % 2u, sg);
    store_ab((step + 1u) % 2u, temp_a, temp_b, map);
  }
  memoryBarrierShared();
  barrier();
  mma_step(step % 2u, sg);
#endif
#endif

  drain_pass(0u, sg, tile_m_start, n4_start, M, N4, W_out);
#if DRAIN_PASSES > 1
  drain_pass(1u, sg, tile_m_start, n4_start, M, N4, W_out);
#endif
#if DRAIN_PASSES > 2
  drain_pass(2u, sg, tile_m_start, n4_start, M, N4, W_out);
  drain_pass(3u, sg, tile_m_start, n4_start, M, N4, W_out);
#endif
#if DRAIN_PASSES != 1 && DRAIN_PASSES != 2 && DRAIN_PASSES != 4
#error "DRAIN_PASSES must be 1, 2 or 4"
#endif
}

#endif // CONV2D_PW_COOPMAT_BODY_GLSLH
