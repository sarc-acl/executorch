// GENERATED by gen_orin_prof.py (measurement only, never shipped) from sarc_linear_dq8ca_coopmat_zpgtr_orin_bf_body.glslh.
// GENERATED by gen_orin_bf.py from sarc_linear_dq8ca_coopmat_zpgtr_body.glslh (whole-texel weight staging;
// valid with INT4 texture2d weights, A_RAW and B_PAIR, without B_SEL_EARLY_N only).
#if !defined(B_PAIR) || !defined(A_RAW) || defined(B_SEL_EARLY_N) || defined(WEIGHT_BUFFER) || !defined(WEIGHT_INT4)
#error orin bf needs INT4 texture2d weights, A_RAW and B_PAIR, without B_SEL_EARLY_N
